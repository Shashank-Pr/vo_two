---
import ProductInventory from '../components/ProductInventory.astro';
import Layout from '../layouts/Layout.astro';


---

		<Layout title="Verified Pre-owned Bikes | VO2 Bikes" description="Browse quality-checked pre-owned bikes with a transparent inspection score on every listing.">


	<section class="page-intro">
			<p class="eyebrow">Pre-owned collection / inspected individually</p>
			<h1 class="display-heading">Good <span>bikes.</span><br />Good to <span>go.</span></h1>
			<p class="lead">Every bike is pre-owned, checked against our 100-point standard, and listed with its score and condition breakdown.</p>
	</section>
	<section class="catalog" aria-label="Performance bicycle inventory">
		<ProductInventory />
	</section>

	<script>
		const SCROLL_KEY = 'vo2:products-scroll';
		history.scrollRestoration = 'manual';

		// Remember the listing position whenever we leave this page — this fires
		// even when the browser caches the page (bfcache).
		window.addEventListener('pagehide', () => {
			sessionStorage.setItem(SCROLL_KEY, String(window.scrollY || 0));
		});

		const isBackForward = performance.getEntriesByType('navigation')[0]?.type === 'back_forward';

		window.addEventListener('pageshow', (event) => {
			// Only restore when arriving via the browser's back/forward (covers
			// both bfcache restores and fresh back-navigation reloads).
			const returning = event.persisted || isBackForward;
			if (!returning) {
				sessionStorage.removeItem(SCROLL_KEY);
				return;
			}
			const saved = Number(sessionStorage.getItem(SCROLL_KEY));
			sessionStorage.removeItem(SCROLL_KEY);
			if (!Number.isFinite(saved) || saved <= 0) return;

			// Re-apply across a few frames so nothing (late images, font swap)
			// nudges the document height after the first scroll.
			let attempt = 0;
			const apply = () => {
				window.scrollTo(0, saved);
				attempt += 1;
				if (attempt < 8) requestAnimationFrame(apply);
			};
			requestAnimationFrame(apply);
		});
	</script>
</Layout>

<style>
	.page-intro { max-width: 1440px; margin: 0 auto; padding: 5rem clamp(1.25rem, 7vw, 7rem) 3rem; }
	.page-intro .display-heading { font-size: clamp(3.8rem, 8vw, 6.5rem); }
	.page-intro .lead { margin: 1.2rem 0 0; }
	.catalog { padding: 0 clamp(1.25rem, 7vw, 7rem) 5rem; background: rgba(8, 12, 15, 0.96);}
	@media (max-width: 640px) { .page-intro { padding-top: 3.5rem; } .catalog { padding-right: 1.2rem; padding-left: 1.2rem; } }
</style>
---
import Layout from '../../layouts/Layout.astro';
import { getAvailableBicycles, urlFor } from '../../data/bicycles';
import { base } from 'astro:config/client';
import backdrop from '../../assets/backdrop.avif';

const inlineStyles = `body { background: #090d10 url('${backdrop.src}') center 42% / cover fixed no-repeat; }`;

export async function getStaticPaths() {
	const bicycles = await getAvailableBicycles();
	return bicycles.map((bike) => ({
		params: { slug: bike.slug },
		props: { bike },
	}));
}

const { bike } = Astro.props;
---

<Layout title={`${bike.name} | vo2bikes`} description={`${bike.year} ${bike.name}, inspected and scored ${bike.score}/100 by vo2bikes.`}>
	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<a href={`${base}/`}>Home</a><span aria-hidden="true">/</span><a href={`${base}/products/`}>Bikes</a><span aria-hidden="true">/</span><span>{bike.name}</span>
	</nav>
	<style is:inline set:html={inlineStyles}></style>
	<section class="product-layout">
		<section class="product-gallery" aria-label={`${bike.name} photos`}>
			<div class="gallery-thumbs" aria-label={`${bike.name} photo thumbnails`}>
				{bike.gallery.map((image, index) => (
					<button
						type="button"
						class:list={['thumb', { 'is-active': index === 0 }]}
						aria-label={`Show ${bike.name} photo ${index + 1}`}
						aria-current={index === 0 ? 'true' : undefined}
						data-index={index}
						data-src={urlFor(image).width(1200).height(900).fit('crop').url()}
						data-zoom={urlFor(image).width(2400).height(1800).fit('crop').url()}
					>
						<img src={urlFor(image).width(140).height(105).fit('crop').url()} alt="" loading="lazy" />
					</button>
				))}
			</div>
			<figure class="gallery-canvas">
				<img
					src={urlFor(bike.gallery[0]).width(1200).height(900).fit('crop').url()}
					alt={`${bike.name}, primary product view`}
					fetchpriority="high"
				/>
				<div class="magnifier" aria-hidden="true"></div>
				<figcaption class="gallery-count">01 / 03</figcaption>
			</figure>
		</section>

		<aside class="product-summary">
			<p class="eyebrow">{bike.year} / {bike.category} / verified pre-owned</p>
			<h1 class="display-heading">{bike.name}</h1>
			<p class="condition">{bike.condition}</p>
			<p class="product-description">{bike.description}</p>
			<div class="price-score">
				<div><span>Asking price</span><strong>{bike.priceLabel}</strong></div>
				<div class="score-summary"><span>Inspection score</span><strong>{bike.score}<small>/100</small></strong></div>
			</div>
			<div class="score-track" aria-hidden="true"><span style={`width: ${bike.score}%`}></span></div>
			<a class="button-primary enquiry-button" href={`mailto:vo2bikes.official@gmail.com?subject=${encodeURIComponent(`Enquiry: ${bike.name}`)}`}>Enquire about this bike <span aria-hidden="true">↗</span></a>
			<a class="inspection-link" href="#inspection">Read the full inspection <span aria-hidden="true">↓</span></a>
		</aside>
	</section>

	<section class="spec-section" aria-labelledby="spec-title">
		<div class="section-heading"><div><p class="eyebrow">Bike details</p><h2 id="spec-title">The <span>spec.</span></h2></div><p>{bike.specification}</p></div>
		<dl class="spec-grid">
			<div><dt>Frame</dt><dd>{bike.frame}</dd></div>
			<div><dt>Groupset</dt><dd>{bike.groupset}</dd></div>
			<div><dt>Wheels</dt><dd>{bike.wheels}</dd></div>
			<div><dt>Size</dt><dd>{bike.size}</dd></div>
			<div><dt>Distance ridden</dt><dd>{bike.distance}</dd></div>
			<div><dt>Condition</dt><dd>{bike.condition}</dd></div>
		</dl>
	</section>

	<section class="inspection-section" id="inspection" aria-labelledby="inspection-title">
		<div class="section-heading">
			<div><p class="eyebrow">Verified by vo2bikes</p><h2 id="inspection-title">Inspection <span>report.</span></h2></div>
			<p>Each area is checked individually. The totals below make up this bike’s score.</p>
		</div>
		<div class="report-score"><strong>{bike.score}</strong><span>/ 100</span><i class="score-track"><i style={`width: ${bike.score}%`}></i></i></div>
		<ul class="check-list">
			{bike.checks.map((check) => (
				<li><span class="check-name"><span aria-hidden="true">✓</span>{check.name}</span><span class="check-points">{check.score}<small> / {check.max}</small></span></li>
			))}
		</ul>
		<p class="report-note">The score reflects this bike’s recorded condition at inspection. Bike-specific measurements and notes are available with the sale.</p>
	</section>

	<script>
		const gallery = document.querySelector('.product-gallery');
		if (gallery) {
			const canvas = gallery.querySelector('.gallery-canvas');
			const lens = gallery.querySelector('.magnifier');
			const mainImage = canvas && canvas.querySelector('img');
			const countEl = gallery.querySelector('.gallery-count');
			const thumbs = [...gallery.querySelectorAll('.thumb')];
			const ZOOM = 2;

			const pad = (n) => String(n).padStart(2, '0');

			const activate = (thumb) => {
				thumbs.forEach((t) => {
					const active = t === thumb;
					t.classList.toggle('is-active', active);
					if (active) t.setAttribute('aria-current', 'true');
					else t.removeAttribute('aria-current');
				});
				mainImage.src = thumb.dataset.src;
				lens.style.backgroundImage = `url('${thumb.dataset.zoom}')`;
				countEl.textContent = `${pad(Number(thumb.dataset.index) + 1)} / ${pad(thumbs.length)}`;
			};

			const lensHalf = Math.round(lens.offsetWidth / 2);

			const setLens = (x, y, width, height) => {
				x = Math.min(Math.max(x, 0), width);
				y = Math.min(Math.max(y, 0), height);
				lens.style.left = `${x}px`;
				lens.style.top = `${y}px`;
				lens.style.backgroundSize = `${width * ZOOM}px ${height * ZOOM}px`;
				lens.style.backgroundPosition = `${-(x * ZOOM) + lensHalf}px ${-(y * ZOOM) + lensHalf}px`;
			};

			const onMove = (event) => {
				if (!lens.classList.contains('is-on')) return;
				const rect = canvas.getBoundingClientRect();
				setLens(event.clientX - rect.left, event.clientY - rect.top, rect.width, rect.height);
			};

			thumbs.forEach((thumb) => {
				thumb.addEventListener('mouseenter', () => activate(thumb));
				thumb.addEventListener('click', () => activate(thumb));
			});

			canvas.addEventListener('mouseenter', (event) => {
				lens.classList.add('is-on');
				canvas.classList.add('is-magnifying');
				onMove(event);
			});
			canvas.addEventListener('mousemove', onMove);
			canvas.addEventListener('mouseleave', () => {
				lens.classList.remove('is-on');
				canvas.classList.remove('is-magnifying');
			});

			activate(thumbs[0]);
		}
	</script>
</Layout>

<style>
	.breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; padding: 1.2rem clamp(1.25rem, 5vw, 5.5rem); color: var(--muted); font-size: 0.66rem; }
	.breadcrumbs a { color: var(--paper); text-decoration-color: var(--signal); text-underline-offset: 3px; }
	.product-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.8fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; padding: 1rem clamp(1.25rem, 7vw, 7rem) 4rem; }
	.product-gallery { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 0.6rem; align-items: start; min-width: 0; }
	.gallery-thumbs { display: flex; flex-direction: column; gap: 0.6rem; }
	.thumb { display: block; width: 100%; padding: 0; border: 1px solid var(--line); background: #151d20; overflow: hidden; cursor: pointer; aspect-ratio: 4 / 3; transition: border-color 160ms ease; }
	.thumb:hover { border-color: var(--muted); }
	.thumb.is-active, .thumb:focus-visible { outline: none; border-color: var(--signal); }
	.thumb:not(.is-active) { opacity: 0.78; }
	.thumb:not(.is-active):hover { opacity: 1; }
	.thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.gallery-canvas { position: relative; margin: 0; overflow: hidden; background: #151d20; aspect-ratio: 4 / 3; cursor: crosshair; }
	.gallery-canvas img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.gallery-canvas.is-magnifying { cursor: none; }
	.magnifier { position: absolute; left: 0; top: 0; width: clamp(120px, 24vw, 190px); aspect-ratio: 1; border-radius: 50%; border: 2px solid rgba(241, 247, 248, 0.95); box-shadow: 0 0 0 1px rgba(9, 13, 16, 0.7), 0 6px 24px rgba(0, 0, 0, 0.55); background-repeat: no-repeat; pointer-events: none; opacity: 0; transform: translate(-50%, -50%); transition: opacity 120ms ease; z-index: 2; }
	.magnifier.is-on { opacity: 1; }
	.product-gallery figcaption { position: absolute; right: 0.7rem; bottom: 0.7rem; padding: 0.4rem 0.5rem; background: rgba(7, 13, 15, 0.8); color: var(--paper); font-size: 0.6rem; z-index: 3; }
	.product-gallery figcaption span { color: var(--signal); }
	.product-summary { position: sticky; top: 1rem; padding: 1.2rem 0; }
	.product-summary .eyebrow { flex-wrap: wrap; font-size: 0.59rem; }
	.product-summary .display-heading { margin: 1.2rem 0 0.4rem; font-size: clamp(3rem, 5vw, 5.3rem); }
	.condition { margin: 0.5rem 0 1.2rem; color: var(--signal); font-size: 0.7rem; font-weight: 600; }
	.product-description { color: #cfdddf; font-size: 0.82rem; line-height: 1.8; }
	.price-score { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
	.price-score div { display: grid; gap: 0.35rem; }
	.price-score span { color: var(--muted); font-size: 0.62rem; }
	.price-score strong { color: var(--paper); font-family: 'Barlow Condensed', sans-serif; font-size: 2rem; }
	.price-score .score-summary { text-align: right; }
	.score-summary strong { color: var(--signal); }
	.score-summary small { margin-left: 0.15rem; color: var(--muted); font: 500 0.7rem 'DM Sans', sans-serif; }
	.score-track { display: block; height: 4px; margin: 0.4rem 0 1.4rem; background: rgba(226, 242, 244, 0.14); }
	.score-track > span { display: block; height: 100%; background: var(--signal); }
	.enquiry-button { width: 100%; }
	.inspection-link { display: block; margin-top: 1rem; color: var(--paper); font-size: 0.7rem; text-align: center; text-decoration-color: var(--signal); text-underline-offset: 4px; }
	.inspection-link span { margin-left: 0.35rem; color: var(--signal); }
	.spec-section, .inspection-section { padding: 4rem clamp(1.25rem, 10vw, 10rem); background: rgba(8, 12, 15, 0.95); }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; max-width: 1200px; margin: 0 auto 1.7rem; }
	.section-heading h2 { margin: 0.5rem 0 0; font-family: 'Barlow Condensed', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); line-height: 0.95; text-transform: uppercase; }
	.section-heading h2 span { color: var(--signal); }
	.section-heading > p { max-width: 360px; margin: 0; color: var(--muted); font-size: 0.75rem; line-height: 1.7; }
	.spec-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 1200px; margin: 0 auto; border-top: 1px solid var(--line); }
	.spec-grid div { padding: 1.2rem 1rem 1.2rem 0; border-bottom: 1px solid var(--line); }
	.spec-grid dt { color: var(--muted); font-size: 0.63rem; }
	.spec-grid dd { margin: 0.45rem 0 0; color: var(--paper); font-size: 0.82rem; }
	.inspection-section { background: rgba(12, 17, 20, 0.98); }
	.report-score { display: grid; grid-template-columns: auto auto 1fr; align-items: baseline; gap: 0.4rem; max-width: 1200px; margin: 0 auto; padding: 1rem 0; border-top: 1px solid var(--line); }
	.report-score > strong { color: var(--signal); font-family: 'Barlow Condensed', sans-serif; font-size: 3.4rem; line-height: 1; }
	.report-score > span { color: var(--muted); font-size: 0.7rem; }
	.report-score .score-track { align-self: center; margin: 0 0 0 1rem; }
	.check-list { max-width: 1200px; margin: 0 auto; padding: 0; list-style: none; }
	.check-list li { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); }
	.check-name { display: flex; align-items: center; gap: 0.65rem; color: var(--paper); font-size: 0.8rem; }
	.check-name > span { color: var(--signal); }
	.check-points { color: var(--paper); font-weight: 700; }
	.check-points small { color: var(--muted); font-size: 0.65rem; }
	.report-note { max-width: 1200px; margin: 1.4rem auto 0; color: var(--muted); font-size: 0.68rem; line-height: 1.7; }
	@media (max-width: 850px) { .product-layout { grid-template-columns: 1fr; } .product-summary { position: static; } }
	@media (max-width: 600px) { .product-gallery { grid-template-columns: 1fr; } .gallery-thumbs { flex-direction: row; } .thumb { flex: 1; } .product-layout { padding-right: 1rem; padding-left: 1rem; } .spec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .section-heading { align-items: start; flex-direction: column; gap: 0.8rem; } }
</style>
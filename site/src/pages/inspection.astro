---
import Layout from '../layouts/Layout.astro';
import { base } from 'astro:config/client';
import inspectionHero from '../assets/inspection_hero.webp';

type InspectionCheck = { name: string; detail: string };

/**
 * Hotspots for the hero banner.
 * Start with none — add them visually at /inspection/?edit-hotspots, then
 * paste the generated config here to save them.
 *
 * x / y are percentages of the hero band (0-100).
 */
const hotspots: Array<{ id: string; x: string; y: string; label: string; title: string; text: string }> = [];

const inspection: Array<{ area: string; points: number; checks: InspectionCheck[] }> = [
	{
		area: 'Frame & fork',
		points: 25,
		checks: [
			{ name: 'Frame overall condition', detail: 'Inspect the entire frame under good lighting for cracks, deformation, deep gouges and suspicious repairs.' },
			{ name: 'Carbon frame and fork', detail: 'Examine impact areas, tube junctions, dropouts and visible carbon surfaces for damage or repair indicators. Visual inspection cannot rule out hidden damage.' },
			{ name: 'Aluminium or steel frame', detail: 'Look for dents, cracks, corrosion, damaged welds, deformation and signs of repair.' },
			{ name: 'Fork and steerer', detail: 'Inspect fork blades, crown, steerer and dropouts for impact damage, cracks, corrosion or deformation.' },
			{ name: 'Head tube and bottom bracket area', detail: 'Inspect for cracks, unusual movement, damage around joints and signs of previous impact.' },
			{ name: 'Rear triangle and dropouts', detail: 'Check stays, dropout alignment, derailleur hanger area and visible damage.' },
			{ name: 'Seatpost and seat tube', detail: 'Check for slipping, seizure, cracks, excessive insertion marks or damage from overtightening.' },
			{ name: 'Frame alignment', detail: 'Look for obvious misalignment; use appropriate alignment tools or specialist assessment if suspected.' },
			{ name: 'Suspension fork or rear shock', detail: 'If fitted, inspect for leaks, stanchion damage, play and functional response.' },
			{ name: 'Suspension service history', detail: "Request records and compare service requirements with the manufacturer's recommendations." },
		],
	},
	{
		area: 'Wheels & tyres',
		points: 20,
		checks: [
			{ name: 'Rims', detail: 'Inspect for cracks, dents, impact damage, worn brake tracks where applicable and damaged spoke holes.' },
			{ name: 'Wheel true and roundness', detail: 'Spin each wheel and assess lateral wobble, vertical hop and clearance.' },
			{ name: 'Hubs and bearings', detail: 'Check for rough rotation, excessive play, binding or abnormal noise.' },
			{ name: 'Spokes and nipples', detail: 'Check for missing, loose, damaged or corroded spokes and damaged nipples.' },
			{ name: 'Tyre tread and casing', detail: 'Inspect tread wear, cuts, bulges, exposed casing, sidewall damage and ageing.' },
			{ name: 'Tyre pressure and retention', detail: "Inflate within the tyre and rim manufacturer's limits; check for pressure loss and secure seating." },
			{ name: 'Tubeless setup', detail: 'If applicable, inspect sealant condition, valve, bead seating and leakage. Confirm compatibility.' },
			{ name: 'Axles and thru-axles', detail: 'Check threads, lever or tool interfaces, seating and secure clamping.' },
			{ name: 'Wheel and axle security', detail: 'Confirm both wheels and all relevant retention mechanisms are secured correctly.' },
		],
	},
	{
		area: 'Drivetrain',
		points: 20,
		checks: [
			{ name: 'Chain condition and wear', detail: 'Measure with a suitable chain-wear gauge and record the result.' },
			{ name: 'Cassette and freewheel', detail: 'Inspect tooth wear, damaged teeth, looseness and unusual skipping under load.' },
			{ name: 'Chainrings', detail: 'Check tooth wear, damage, looseness and chain retention.' },
			{ name: 'Front and rear derailleurs', detail: 'Inspect cage, pivots, mounting, hanger and visible damage.' },
			{ name: 'Shifting across gears', detail: 'Test each gear combination appropriate to the setup and record missed shifts or hesitation.' },
			{ name: 'Crankset and crank arms', detail: 'Check for cracks, impact damage, loose hardware and abnormal movement.' },
			{ name: 'Bottom bracket', detail: 'Check for play, roughness, noise and secure installation.' },
			{ name: 'Pedals and cleats', detail: 'Inspect pedal bearings, threads, retention mechanism and cleat wear if included.' },
			{ name: 'Freehub and engagement', detail: 'Check for abnormal play, slipping, roughness or inconsistent engagement.' },
			{ name: 'Electronic shifting', detail: 'If fitted, test shifting, battery status, connections and error indicators.' },
			{ name: 'Drivetrain function', detail: 'Check shifting, chain retention and pedal/crank function.' },
		],
	},
	{
		area: 'Braking',
		points: 15,
		checks: [
			{ name: 'Brake levers and operation', detail: 'Check smooth operation, return action, secure mounting and appropriate lever feel.' },
			{ name: 'Brake pads', detail: 'Inspect remaining material, contamination, uneven wear and correct installation.' },
			{ name: 'Rotors or rim brake tracks', detail: 'Check rotor thickness against its limit, warping, cracks and contamination; inspect rim brake tracks where applicable.' },
			{ name: 'Hydraulic brakes', detail: 'Check for leaks, damaged hoses, damaged fittings and abnormal lever travel.' },
			{ name: 'Cables and housing', detail: 'For mechanical systems, inspect fraying, corrosion, routing and smooth operation.' },
			{ name: 'Brake alignment and clearance', detail: 'Check caliper alignment, pad contact, rotor rub and wheel clearance.' },
			{ name: 'Static brake test', detail: 'Confirm both brakes hold the bicycle securely and operate independently.' },
			{ name: 'Brake function', detail: 'Confirm both brakes function correctly before any ride test.' },
		],
	},
	{
		area: 'Cockpit & fit',
		points: 10,
		checks: [
			{ name: 'Handlebar', detail: 'Inspect for cracks, dents, corrosion, deformation and secure mounting; pay particular attention to carbon bars.' },
			{ name: 'Stem and faceplate', detail: 'Check for damage, correct assembly and appropriate torque where specifications are available.' },
			{ name: 'Headset', detail: 'Check for play, binding, roughness and smooth steering.' },
			{ name: 'Handlebar tape and grips', detail: 'Record condition, wear and whether replacement is needed.' },
			{ name: 'Saddle and rails', detail: 'Inspect for cracks, rail damage, deformation and secure mounting.' },
			{ name: 'Seatpost clamp and hardware', detail: 'Check function, condition and correct clamping; follow manufacturer torque requirements.' },
			{ name: 'Cables, hoses and routing', detail: 'Inspect for abrasion, pinching, sharp bends, leaks and interference with steering.' },
			{ name: 'Steering and bearing function', detail: 'Confirm smooth steering without abnormal play or binding.' },
			{ name: 'Fastener check', detail: 'Check safety-critical fasteners using the correct tools and manufacturer torque specifications where available.' },
		],
	},
	{
		area: 'Ride test & records',
		points: 10,
		checks: [
			{ name: 'Seller identity and ownership', detail: 'Confirm seller identity and obtain a signed declaration that they own the bicycle and are authorised to sell it.' },
			{ name: 'Frame serial number', detail: 'Photograph the serial number and check it against available documents and any relevant stolen-bike records.' },
			{ name: 'Purchase documentation', detail: 'Request the original invoice, proof of purchase or other supporting ownership evidence, if available.' },
			{ name: 'Model and specification', detail: 'Confirm brand, model, model year if verifiable, frame size and component specification.' },
			{ name: 'Modification history', detail: 'Ask about crashes, frame repairs, repainting, component upgrades and major replacements.' },
			{ name: 'Included items', detail: 'Record wheels, pedals, charger, battery, accessories, manuals and keys where applicable.' },
			{ name: 'Lights, computer and accessories', detail: 'Test included electronic accessories and record what is included in the sale.' },
			{ name: 'E-bike motor and battery', detail: 'If applicable, check diagnostic status, charging, assistance operation and battery health through appropriate tools or records.' },
			{ name: 'E-bike charger and keys', detail: 'Verify charger compatibility, battery locking and the presence of keys.' },
			{ name: 'Controlled test ride', detail: 'Only after safety-critical checks pass, test handling, braking and drivetrain operation in a safe area.' },
			{ name: 'Abnormal noise or movement', detail: 'Record creaks, knocking, rubbing, vibration, slipping or other unexplained symptoms.' },
			{ name: 'Post-ride recheck', detail: 'Reinspect for newly apparent issues, loosened components or fluid leakage.' },
			{ name: 'Photographic record', detail: 'Capture full bicycle views, serial number, frame details, drivetrain, wheels, brakes and every material defect.' },
			{ name: 'Defect register', detail: 'Record each defect, its severity, evidence and proposed action.' },
			{ name: 'Refurbishment estimate', detail: 'List required parts, labour, service costs and any specialist inspection.' },
			{ name: 'Purchase economics', detail: 'Calculate purchase price, transport, parts, labour and expected selling costs before approving purchase.' },
			{ name: 'Final inspection record', detail: 'Record inspection date, inspector names, test limitations and final decision.' },
			{ name: 'Customer disclosure', detail: 'Disclose material known defects, replaced parts, incomplete checks and relevant repair history.' },
			{ name: 'Sale handover', detail: 'Provide agreed inclusions, receipt or invoice and any written terms or warranty offered.' },
		],
	},
];
---

<Layout title="What Sets Us Apart | vo2bikes" description="See the checks behind every vo2bikes pre-owned bicycle inspection score.">
	<section class="page-intro hero-band" style={`--hero-bg: #090d10 url(${inspectionHero.src}) center / cover no-repeat`}>
		<div class="intro-inner">
			<p class="eyebrow">Our promise / one standard for every bike</p>
			<h1 class="display-heading">Verified  <span>bikes. </span><br> Confident <span> ride.</span></h1>
			<p class="lead">Every pre-owned bike is inspected before it reaches the showroom. We score six areas out of 100 and show the breakdown with the listing.</p>
		</div>
		<div class="hero-hotspots" aria-label="Inspection highlights">
			{hotspots.map((hs) => (
				<div class="hotspot" style={`--x: ${hs.x}; --y: ${hs.y};`} data-id={hs.id}>
					<button class="hotspot-dot" type="button" aria-expanded="false" aria-controls={hs.id}>
						<span class="sr-only">{hs.label}</span>
					</button>
					<div class="hotspot-tip" id={hs.id} role="tooltip">
						<strong>{hs.title}</strong>
						<p>{hs.text}</p>
					</div>
				</div>
			))}
		</div>
		<div class="hotspot-toolbar" hidden>
			<button type="button" class="editor-add">+ Add hotspot</button>
			<button type="button" class="editor-copy">Copy config</button>
			<span class="editor-status" aria-live="polite"></span>
		</div>
	</section>

	<aside class="hotspot-editor" hidden>
		<div class="editor-head">
			<p><strong>Hotspot editor</strong> — click <em>+ Add hotspot</em> then click the banner to place a circle. Drag any circle to move it. Write the text shown on hover/tap below. Copy the config into <code>hotspots</code> in <code>inspection.astro</code> to save.</p>
			<p class="editor-status" aria-live="polite"></p>
		</div>
		<div class="editor-list"></div>
		<details class="editor-raw" open>
			<summary>Config output</summary>
			<pre class="editor-output"></pre>
		</details>
	</aside>

	<section class="inspection-section" id="checklist" aria-labelledby="checklist-title">
		<div class="inspection-heading">
			<div><p class="eyebrow">What we check</p><h2 id="checklist-title">The inspection <span>checklist.</span></h2></div>
			<p>Each listing carries bike-specific readings and notes against these checks.</p>
		</div>
		<section class="score-summary" aria-label="Inspection score structure">
		<div><strong>100</strong><span>total points</span></div>
		<div><strong>6</strong><span>inspection areas</span></div>
		<div><strong>1</strong><span>road test per bike</span></div>
	</section>
		<div class="inspection-grid">
			{inspection.map((group, index) => (
				<article class="inspection-card">
					<header><span class="inspection-number">0{index + 1}</span><div><h3>{group.area}</h3><span class="weight">{group.points} points</span></div></header>
					<ul>{group.checks.map((item) => <li><span class="check-mark" aria-hidden="true">✓</span><span class="check-copy">{item.name}<small>{item.detail}</small></span></li>)}</ul>
				</article>
			))}
		</div>
		<p class="score-note">Inspection notes are recorded for each individual bike. The score reflects its condition at the time it was checked.</p>
	</section>

	<section class="inspection-cta">
		<div><p class="eyebrow">Transparent by design</p><h2>See the score.<br />Choose your <span> bike.</span></h2></div>
		<a class="button-primary" href={`${base}`}>Shop inspected bikes <span aria-hidden="true">↗</span></a>
	</section>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		const hero = document.querySelector('.page-intro.hero-band');
		const layer = hero?.querySelector('.hero-hotspots');
		if (!hero || !(layer instanceof HTMLElement)) return;

		const getHotspots = () => Array.from(layer.querySelectorAll('.hotspot'));

		const closeAll = (except) => {
			getHotspots().forEach((hs) => {
				if (hs === except) return;
				hs.classList.remove('is-open');
				const btn = hs.querySelector('.hotspot-dot');
				if (btn) btn.setAttribute('aria-expanded', 'false');
			});
		};

		const bindHotspot = (hs) => {
			const btn = hs.querySelector('.hotspot-dot');
			if (!(btn instanceof HTMLElement) || btn.dataset.bound === '1') return;
			btn.dataset.bound = '1';
			let dragged = false;
			btn.addEventListener('click', (e) => {
				if (dragged) { dragged = false; return; }
				e.preventDefault();
				e.stopPropagation();
				const open = hs.classList.toggle('is-open');
				btn.setAttribute('aria-expanded', open ? 'true' : 'false');
				if (open) closeAll(hs);
			});
			// Expose for drag logic
			hs._setDragged = () => { dragged = true; };
		};

		getHotspots().forEach(bindHotspot);

		document.addEventListener('click', (e) => {
			if (!(e.target instanceof Element) || !e.target.closest('.hotspot')) closeAll();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') closeAll();
		});

		// Placement/edit mode: open /inspection/?edit-hotspots
		const params = new URLSearchParams(location.search);
		if (!params.has('edit-hotspots')) return;

		const editor = document.querySelector('.hotspot-editor');
		const toolbar = hero.querySelector('.hotspot-toolbar');
		const output = editor?.querySelector('.editor-output');
		const copyBtn = toolbar?.querySelector('.editor-copy');
		const addBtn = toolbar?.querySelector('.editor-add');
		const listEl = editor?.querySelector('.editor-list');
		const statusEl = toolbar?.querySelector('.editor-status');
		const editorStatusEl = editor?.querySelector('.editor-status');
		if (!(editor instanceof HTMLElement) || !(output instanceof HTMLElement) || !(listEl instanceof HTMLElement) || !(toolbar instanceof HTMLElement)) return;

		editor.hidden = false;
		toolbar.hidden = false;
		hero.classList.add('is-editing-hotspots');

		const esc = (s) => String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
		const pct = (n) => `${Math.max(0, Math.min(100, n)).toFixed(2)}%`;
		const setStatus = (msg) => {
			if (statusEl instanceof HTMLElement) statusEl.textContent = msg || '';
			if (editorStatusEl instanceof HTMLElement) editorStatusEl.textContent = msg || '';
		};

		// Astro scopes CSS with data-astro-cid-* attributes. Elements created by
		// this editor need the same attributes or none of the styles apply.
		const scopeAttrs = Array.from(layer.attributes)
			.filter((a) => a.name.startsWith('data-astro-cid-'))
			.map((a) => [a.name, a.value] as const);
		const applyScope = (el: Element) => {
			scopeAttrs.forEach(([name, value]) => el.setAttribute(name, value));
			Array.from(el.children).forEach(applyScope);
		};

		const readHotspot = (hs) => ({
			id: hs.getAttribute('data-id') || `hs-${Date.now()}`,
			x: hs.style.getPropertyValue('--x').trim() || '50%',
			y: hs.style.getPropertyValue('--y').trim() || '50%',
			label: hs.querySelector('.sr-only')?.textContent?.trim() || '',
			title: hs.querySelector('.hotspot-tip strong')?.textContent?.trim() || '',
			text: hs.querySelector('.hotspot-tip p')?.textContent?.trim() || '',
		});

		let state = getHotspots().map(readHotspot);
		let placing = false;
		let selectedId = null;

		const renderOutput = () => {
			const items = state.map((h) => `\t{ id: '${esc(h.id)}', x: '${esc(h.x)}', y: '${esc(h.y)}', label: '${esc(h.label || h.title)}', title: '${esc(h.title)}', text: '${esc(h.text)}' },`);
			output.textContent = `const hotspots = [\n${items.join('\n')}\n];`;
		};

		const syncHotspotDom = (item) => {
			const hs = layer.querySelector(`.hotspot[data-id="${CSS.escape(item.id)}"]`);
			if (!(hs instanceof HTMLElement)) return;
			hs.style.setProperty('--x', item.x);
			hs.style.setProperty('--y', item.y);
			const sr = hs.querySelector('.sr-only');
			const strong = hs.querySelector('.hotspot-tip strong');
			const p = hs.querySelector('.hotspot-tip p');
			if (sr) sr.textContent = item.label || item.title || 'Hotspot';
			if (strong) strong.textContent = item.title || '';
			if (p) p.textContent = item.text || '';
		};

		const renderList = () => {
			listEl.innerHTML = '';
			state.forEach((item) => {
				const row = document.createElement('div');
				row.className = 'editor-item' + (item.id === selectedId ? ' selected' : '');
				row.dataset.id = item.id;
				row.innerHTML = `
					<div class="editor-item-grid">
						<label class="field-full">Title<input type="text" data-field="title" value=""></label>
						<label class="field-full">Info text<textarea data-field="text"></textarea></label>
						<label>X<input type="text" data-field="x" value=""></label>
						<label>Y<input type="text" data-field="y" value=""></label>
						<div class="editor-item-actions"><button type="button" class="editor-delete">Delete</button></div>
					</div>`;
				row.querySelector('[data-field="title"]').value = item.title || '';
				row.querySelector('[data-field="text"]').value = item.text || '';
				row.querySelector('[data-field="x"]').value = item.x || '';
				row.querySelector('[data-field="y"]').value = item.y || '';
				row.addEventListener('click', (e) => {
					if (e.target instanceof Element && e.target.closest('button,input,textarea')) return;
					selectedId = item.id;
					renderList();
				});
				row.querySelectorAll('input,textarea').forEach((el) => {
					el.addEventListener('input', () => {
						const field = el.getAttribute('data-field');
						if (!field) return;
						item[field] = el.value;
						if (field === 'title' && !item.label) item.label = item.title;
						syncHotspotDom(item);
						renderOutput();
					});
				});
				row.querySelector('.editor-delete')?.addEventListener('click', () => {
					state = state.filter((h) => h.id !== item.id);
					layer.querySelector(`.hotspot[data-id="${CSS.escape(item.id)}"]`)?.remove();
					if (selectedId === item.id) selectedId = null;
					renderList();
					renderOutput();
					setStatus('Hotspot removed. Copy config to save changes.');
				});
				listEl.appendChild(row);
			});
		};

		const createHotspotDom = (item) => {
			const hs = document.createElement('div');
			hs.className = 'hotspot';
			hs.style.setProperty('--x', item.x);
			hs.style.setProperty('--y', item.y);
			hs.setAttribute('data-id', item.id);
			hs.innerHTML = `
				<button class="hotspot-dot" type="button" aria-expanded="false" aria-controls="${item.id}">
					<span class="sr-only"></span>
				</button>
				<div class="hotspot-tip" id="${item.id}" role="tooltip">
					<strong></strong>
					<p></p>
				</div>`;
			layer.appendChild(hs);
			applyScope(hs);
			bindHotspot(hs);
			syncHotspotDom(item);
			return hs;
		};

		const ensureDomMatchesState = () => {
			// Existing DOM already matches initial state; future adds use createHotspotDom
		};

		renderList();
		renderOutput();
		ensureDomMatchesState();

		if (copyBtn instanceof HTMLButtonElement) {
			copyBtn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(output.textContent || '');
					copyBtn.textContent = 'Copied';
					setTimeout(() => { copyBtn.textContent = 'Copy config'; }, 1200);
					setStatus('Config copied. Paste it into the hotspots array in inspection.astro to save.');
				} catch {
					copyBtn.textContent = 'Copy failed';
					setTimeout(() => { copyBtn.textContent = 'Copy config'; }, 1200);
				}
			});
		}

		if (addBtn instanceof HTMLButtonElement) {
			addBtn.addEventListener('click', () => {
				placing = true;
				hero.classList.add('placing-hotspot');
				setStatus('Click on the banner image to place the new hotspot.');
			});
		}

		hero.addEventListener('click', (e) => {
			if (!(e.target instanceof Element)) return;
			if (e.target.closest('.hotspot-editor')) return;
			if (e.target.closest('.hotspot')) return;
			if (!placing) return;
			const rect = hero.getBoundingClientRect();
			const x = pct(((e.clientX - rect.left) / rect.width) * 100);
			const y = pct(((e.clientY - rect.top) / rect.height) * 100);
			const item = { id: `hs-${Date.now()}`, x, y, label: 'New hotspot', title: 'New hotspot', text: 'Add info text here.' };
			state.push(item);
			selectedId = item.id;
			createHotspotDom(item);
			renderList();
			renderOutput();
			placing = false;
			hero.classList.remove('placing-hotspot');
			setStatus('Hotspot added. Edit its title/text, drag to fine-tune, then copy config to save.');
			const titleInput = listEl.querySelector(`.editor-item[data-id="${CSS.escape(item.id)}"] [data-field="title"]`);
			if (titleInput instanceof HTMLInputElement) { titleInput.focus(); titleInput.select(); }
		});

		// Drag to reposition (updates state + editor inputs)
		let dragging = null;
		let dragMoved = false;
		layer.addEventListener('pointerdown', (e) => {
			const dot = e.target instanceof Element ? e.target.closest('.hotspot-dot') : null;
			const hs = dot ? dot.closest('.hotspot') : null;
			if (!(dot instanceof HTMLElement) || !(hs instanceof HTMLElement)) return;
			dragging = hs;
			dragMoved = false;
			dot.setPointerCapture(e.pointerId);
			e.stopPropagation();
		});
		layer.addEventListener('pointermove', (e) => {
			if (!(dragging instanceof HTMLElement)) return;
			const rect = hero.getBoundingClientRect();
			const x = pct(((e.clientX - rect.left) / rect.width) * 100);
			const y = pct(((e.clientY - rect.top) / rect.height) * 100);
			dragging.style.setProperty('--x', x);
			dragging.style.setProperty('--y', y);
			const id = dragging.getAttribute('data-id');
			const item = state.find((h) => h.id === id);
			if (item) {
				item.x = x; item.y = y;
				const row = listEl.querySelector(`.editor-item[data-id="${CSS.escape(id)}"]`);
				if (row) {
					const xi = row.querySelector('[data-field="x"]');
					const yi = row.querySelector('[data-field="y"]');
					if (xi instanceof HTMLInputElement) xi.value = x;
					if (yi instanceof HTMLInputElement) yi.value = y;
				}
			}
			dragMoved = true;
		});
		const endDrag = () => {
			if (!dragging) return;
			if (dragMoved && typeof dragging._setDragged === 'function') dragging._setDragged();
			dragging = null;
			if (dragMoved) { renderOutput(); setStatus('Position updated. Copy config to save changes.'); }
			dragMoved = false;
		};
		layer.addEventListener('pointerup', endDrag);
		layer.addEventListener('pointercancel', endDrag);
	});
	// Fallback for initial load when view transitions aren't active
	if (document.readyState !== 'loading') {
		document.dispatchEvent(new Event('astro:page-load'));
	} else {
		document.addEventListener('DOMContentLoaded', () => document.dispatchEvent(new Event('astro:page-load')));
	}
</script>

<style>
	.page-intro { position: relative; max-width: 1440px; margin: 0 auto; padding: 5rem clamp(1.25rem, 10vw, 10rem) 3rem; background: var(--hero-bg); overflow: hidden; }
	.page-intro .lead { margin: 1.2rem 0 0; }
	.intro-inner { position: relative; z-index: 2; }
	.hero-hotspots { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
	.hotspot { position: absolute; left: var(--x); top: var(--y); pointer-events: auto; }
	.hotspot-dot {
		position: relative;
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		padding: 0;
		border: 2px solid #ff4d6d;
		border-radius: 50%;
		background: rgba(255, 20, 60, 0.18);

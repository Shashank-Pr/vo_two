				</style>
				<script>
					/* Dropdowns in the header: close on outside click, Escape or link
					   activation, and only one panel open at a time. */
					const closeableMenus = [
						...document.querySelectorAll<HTMLDetailsElement>('.nav-more, .header-contact'),
					];
					closeableMenus.forEach((menu) => {
						const closeMenu = () => menu.removeAttribute('open');
						document.addEventListener('click', (event) => {
							if (menu.open && !menu.contains(event.target as Node)) closeMenu();
						});
						document.addEventListener('keydown', (event) => {
							if (event.key === 'Escape' && menu.open) closeMenu();
						});
						menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
						menu.addEventListener('toggle', () => {
							if (!menu.open) return;
							closeableMenus.forEach((other) => {
								if (other !== menu) other.removeAttribute('open');
							});
						});
					});
				</script>

---
		interface Props {
			title?: string;
			description?: string;
		}

		const {
			title = 'VO2 Bikes | Verified Pre-owned Bikes',
			description = 'Shop quality-checked pre-owned road and gravel bikes, each inspected and scored out of 100.',
		} = Astro.props;
		const currentPath = Astro.url.pathname;
import { base } from 'astro:config/client';
import Logo from '../assets/logo_combined_png.png';
import backdrop from '../assets/logo3.webp';
import instagramIcon from '../assets/insta.jpg';
import whatsappIcon from '../assets/whatsapp.png';
import { contactEmail, instagramUrl, whatsappHref } from '../data/contact';

const bg_url = backdrop.src;
const bodyBackground = `body { background: #090d10 url('${backdrop.src}') center 42% / cover fixed no-repeat; }`; 
---

		<!doctype html>
		<html lang="en">
			<head>
				<meta charset="utf-8" />
				<meta name="viewport" content="width=device-width, initial-scale=1" />
				<meta name="description" content={description} />
				<meta name="theme-color" content="#090d10" />
				<meta name="generator" content={Astro.generator} />
				<link rel="preconnect" href="https://fonts.googleapis.com" />
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
				<!-- <style is:inline set:html={bodyBackground}></style> -->
				<title>{title}</title>
			</head>
			<body>
				<div class="site-shell">
					<header class="site-header">
						<a class="wordmark" href={`${base}/`} aria-label="vo2bikes home">
							<img class="wordmark-mark" aria-hidden="true" src={`${Logo.src}`}>
						</a>
						<nav class="primary-nav" aria-label="Main navigation">
							<a data-nav="buy" href={`${base}/`} aria-current={currentPath === `${base}/` || currentPath.startsWith(`${base}/products/`) ? 'page' : undefined}>BUY BIKES</a>
							<a href={`${base}/sell/`} aria-current={currentPath.startsWith(`${base}/sell/`) ? 'page' : undefined}>SELL YOUR BIKE</a>
							<a data-nav="rent" href={`${base}/rent/`} aria-current={currentPath.startsWith(`${base}/rent/`) ? 'page' : undefined}>RENT BIKES</a>
							<a href={`${base}/services/`} aria-current={currentPath.startsWith(`${base}/services/`) ? 'page' : undefined}>SERVICES</a>
							<a class="nav-wide" href={`${base}/inspection/`} aria-current={currentPath.startsWith(`${base}/inspection/`) ? 'page' : undefined}>INSPECTION</a>
							<a class="nav-wide" href={`${base}/about/`} aria-current={currentPath.startsWith(`${base}/about/`) ? 'page' : undefined}>ABOUT</a>
							<details class="nav-more" aria-current={currentPath.startsWith(`${base}/inspection/`) || (currentPath.startsWith(`${base}/about/`)) ? 'page' : undefined}>
								<summary>More</summary>
								<div class="nav-more-list">
									<a href={`${base}/inspection/`} aria-current={currentPath.startsWith(`${base}/inspection/`) ? 'page' : undefined}>INSPECTION</a>
									<!-- <a href={`${base}/sell/`} aria-current={currentPath.startsWith(`${base}/sell/`) ? 'page' : undefined}>Sell your bike</a> -->
									<a href={`${base}/about/`} aria-current={currentPath.startsWith(`${base}/about/`) ? 'page' : undefined}>About</a>
								</div>
							</details>
						</nav>
						<script is:inline>
							// Bike detail pages are prerendered, so the buy/rent context can
							// only be read at runtime from the URL. Opening a bike from the
							// rental fleet carries ?mode=rent, which moves the nav highlight
							// from BUY BIKES to RENT BIKES.
							(() => {
								if (new URLSearchParams(location.search).get('mode') !== 'rent') return;
								const nav = document.querySelector('.primary-nav');
								const buy = nav?.querySelector('[data-nav="buy"]');
								const rent = nav?.querySelector('[data-nav="rent"]');
								if (!buy || !rent) return;
								buy.removeAttribute('aria-current');
								rent.setAttribute('aria-current', 'page');
							})();
						</script>
						<a class="header-cta" href={whatsappHref("Hi VO2 Bikes!")} target="_blank" rel="noopener noreferrer">Contact Us <span aria-hidden="true">↗</span></a>
					</header>
					<main>
						<slot />
					</main>
					<footer class="site-footer">
						<a class="footer-wordmark" href={`${base}/`}>VO<sub>2</sub> Bikes <span>/ RIDE. VERIFIED</span></a>
						<p>Better bikes. Better backed.</p>
						<div class="footer-contact">
							<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
							<a class="footer-social" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="vo2bikes on Instagram" title="Instagram"><img src={instagramIcon.src} alt="" width="26" height="26" loading="lazy" /></a>
							<a class="footer-social" href={whatsappHref("Hi VO2 Bikes! I have a question about one of your bikes.")} target="_blank" rel="noopener noreferrer" aria-label="Message vo2bikes on WhatsApp" title="WhatsApp"><img src={whatsappIcon.src} alt="" width="26" height="26" loading="lazy" /></a>
						</div>
					</footer>
				</div>
				<script>
					const navMore = document.querySelector<HTMLDetailsElement>('.nav-more');
					if (navMore) {
						const closeNavMore = () => navMore.removeAttribute('open');
						document.addEventListener('click', (event) => {
							if (navMore.open && !navMore.contains(event.target as Node)) closeNavMore();
						});
						document.addEventListener('keydown', (event) => {
							if (event.key === 'Escape' && navMore.open) closeNavMore();
						});
						navMore.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavMore));
					}
				</script>
			</body>
		</html>

		<style is:global define:vars={{ parsedBg: `#090d10 url("${bg_url}") center 42% / cover no-repeat` }}>
			:root {
				font-family: 'DM Sans', sans-serif;
				color: #f1f7f8;
				background: #090d10;
				font-synthesis: none;
				text-rendering: optimizeLegibility;
				--ink: #090d10;
				--panel: rgba(10, 15, 18, 0.94);
				--paper: #f1f7f8;
				--muted: #aab8bc;
				--line: rgba(226, 242, 244, 0.18);
				--signal: #00ff11;
				/* One shared height for every page hero, so the fixed background
				   image is framed identically on every page. */
				--hero-band-min: min(700px, calc(100svh - 88px));
				--hero-bg: var(--parsedBg);
			}
			/* Every top-level page hero uses this band, so the transparent area
			   above the first opaque section is the same height everywhere. */
			.hero-band { display: flex; flex-direction: column; justify-content: center; min-height: var(--hero-band-min); }
			@media (max-width: 760px) { :root { --hero-band-min: min(560px, calc(100svh - 150px)); } }
			* { box-sizing: border-box; }
			html { min-width: 320px; scroll-behavior: smooth; }
			body {
				margin: 0;
				min-width: 320px;
				min-height: 100vh;
			}
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				background: linear-gradient(90deg, rgba(5, 9, 12, 0.91), rgba(5, 9, 12, 0.75) 55%, rgba(5, 9, 12, 0.78)), linear-gradient(0deg, rgba(5, 9, 12, 0.63), transparent 55%);
			}
			a { color: inherit; }
			button, input, select { font: inherit; }
			button, a, select { -webkit-tap-highlight-color: transparent; }
			.site-shell { min-height: 100vh; }
			.site-header {
				position: relative;
				z-index: 2;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
				min-height: 88px;
				padding: 0 clamp(1.25rem, 5vw, 5.5rem);
				border-bottom: 1px solid var(--line);
				background: rgba(8, 12, 15, 0.82);
				backdrop-filter: blur(14px);
			}
			.wordmark { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; }
			.wordmark-mark {
				display: grid;
				place-items: center;
				width: 150px;
				height: 50px;
				aspect-ratio: 1;
				/* border: 1px solid var(--signal); */
				color: var(--signal);
				font-family: 'Barlow Condensed', sans-serif;
				font-size: 1.25rem;
				font-weight: 700;
				margin-left: 3vw;
			}
			.wordmark-mark span { color: var(--paper); }
			.wordmark-name { font-family: 'Barlow Condensed', sans-serif; font-size: 1.75rem; font-weight: 700; line-height: 1.05; letter-spacing: 0.04em;  }
			.wordmark-name sub { font-size: 0.9em; vertical-align: -0.2em; }
			.wordmark-name b { color: var(--signal); }
			.wordmark-name small { display: block;  font-family: 'Courier New', Courier, monospace; font-weight: 700; font-size: 0.8rem; /* monospace math: 7.75 units wide × 1.2rem ÷ 14 tag chars — makes both lines equal width so their right edges align */ letter-spacing: 0; }
			.primary-nav { display: flex; align-items: center; gap: clamp(0.9rem, 2.2vw, 2.4rem); }
			.primary-nav a { position: relative; padding: 0.5rem 0; color: #d7e2e4; font-size: 0.78rem; font-weight: 600; text-decoration: none; transition: color 160ms ease; }
			.primary-nav a::after { position: absolute; right: 0; bottom: 0; left: 0; height: 2px; background: var(--signal); content: ''; transform: scaleX(0); transform-origin: left; transition: transform 160ms ease; }
			.primary-nav a:hover, .primary-nav a[aria-current='page'] { color: var(--paper); }
			.primary-nav a:hover::after, .primary-nav a[aria-current='page']::after { transform: scaleX(1); }
			.nav-more { display: none; position: relative; }
			.nav-more summary { display: flex; align-items: center; gap: 0.35rem; padding: 0.5rem 0; color: #d7e2e4; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; list-style: none; cursor: pointer; }
			.nav-more summary::-webkit-details-marker { display: none; }
			.nav-more summary::after { color: var(--signal); content: '▾'; font-size: 0.9em; transition: transform 160ms ease; }
			.nav-more[open] summary::after { transform: rotate(180deg); }
			.nav-more summary:focus-visible { outline: 1px solid var(--signal); outline-offset: 3px; }
			.nav-more-list { position: absolute; top: calc(100% + 0.55rem); right: 0; z-index: 10; display: grid; min-width: 190px; padding: 0.4rem; border: 1px solid var(--line); background: rgba(8, 12, 15, 0.98); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5); }
			.nav-more-list a { padding: 0.7rem 0.85rem; color: #d7e2e4; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; text-decoration: none; }
			.nav-more-list a::after { display: none; }
			.nav-more-list a:hover, .nav-more-list a[aria-current='page'] { color: var(--paper); background: var(--line); }
			.header-cta, .button-primary {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				min-height: 44px;
				padding: 0.7rem 1rem;
				border: 1px solid var(--signal);
				background: var(--signal);
				color: var(--ink);
				font-size: 0.74rem;
				font-weight: 700;
				text-decoration: none;
				transition: background 160ms ease, color 160ms ease;
			}
			.header-cta:hover, .button-primary:hover { background: transparent; color: var(--signal); }
			.button-secondary { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--paper); font-size: 0.76rem; font-weight: 700; text-decoration-color: var(--signal); text-underline-offset: 5px; }
			.eyebrow { display: flex; align-items: center; gap: 0.65rem; color: var(--signal); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
			.eyebrow::before { width: 25px; height: 1px; background: currentColor; content: ''; }
			.display-heading { margin: 1rem 0; font-family: 'Barlow Condensed', sans-serif; font-size: clamp(2.4rem, 6.6vw, 5.6rem); font-weight: 700; line-height: 0.9; text-transform: uppercase; }
			.display-heading span { color: var(--signal); }
			.lead { max-width: 570px; color: #d4e0e2; font-size: 1rem; line-height: 1.75; }
			.site-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.75rem clamp(1.25rem, 5vw, 5.5rem); border-top: 1px solid var(--line); background: rgba(7, 10, 12, 0.9); color: var(--muted); font-size: 0.72rem; }
			.site-footer p { margin: 0; }
			.footer-wordmark { color: var(--paper); font-family: 'Barlow Condensed', sans-serif; font-size: 1rem; font-weight: 700; text-decoration: none; }
			.footer-wordmark span { color: var(--muted); font: 600 0.58rem 'DM Sans', sans-serif; letter-spacing: 0.1em; }
			.footer-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.25rem; }
			.footer-contact a { color: var(--muted); text-decoration-color: var(--signal); text-underline-offset: 4px; }
			.footer-contact a:hover { color: var(--paper); }
			.footer-social { display: inline-flex; align-items: center; text-decoration: none; }
			.footer-social img { display: block; width: 26px; height: 26px; opacity: 0.88; transition: opacity 160ms ease, transform 160ms ease; }
			.footer-social:hover img, .footer-social:focus-visible img { opacity: 1; transform: translateY(-2px); }
			@media (max-width: 1024px) {
				.site-header { flex-wrap: wrap; gap: 0.7rem 1rem; padding-top: 0.85rem; padding-bottom: 0.85rem; }
				.wordmark { margin-right: auto; }
				.primary-nav { order: 3; width: 100%; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; }
				.primary-nav a { font-size: 0.7rem; }
				.header-cta { min-height: 38px; padding: 0.55rem 0.7rem; font-size: 0.68rem; }
				.site-footer { flex-wrap: wrap; }
			}
			@media (max-width: 640px) {
				.site-header { padding-left: 1rem; padding-right: 1rem; }
				.wordmark-mark { width: clamp(128px, 38vw, 190px); height: auto; aspect-ratio: auto; }
				.header-cta { min-height: 34px; padding: 0.5rem 0.6rem; font-size: 0.62rem; gap: 0.5rem; }
				.primary-nav a, .nav-more summary { font-size: 0.68rem; }
				.nav-wide { display: none; }
				.nav-more { display: block; }
				.nav-more[aria-current = 'page']::after {position: absolute; right: 0; bottom: 0; left: 0; height: 2px; background: var(--signal); content: ''; transform: scaleX(1); transform-origin: left; transition: transform 160ms ease; }
				.site-footer { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
			}
			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				*, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
			}
		</style>

---
		interface Props {
			title?: string;
			description?: string;
			/** Enables the WhatsApp / Facebook / Instagram share options in the share sheet. */
			socialShare?: boolean;
			/** Keeps an unlisted page out of search-engine results. */
			noindex?: boolean;
			/** Removes all main-site chrome; used by the standalone sharing workspace. */
			shareOnly?: boolean;
		}

		const {
			title = 'VO2 Bikes | Verified Pre-owned Bikes',
			description = 'Shop quality-checked pre-owned road and gravel bikes, each inspected and scored out of 100.',
			socialShare = false,
			noindex = false,
			shareOnly = false,
		} = Astro.props;
		const currentPath = Astro.url.pathname;
		/* On the unlisted sharing workspace, Buy/Rent tabs are separate static pages. */
		const shareRent = socialShare && currentPath.startsWith(`${base}share/rent`);
import { base } from 'astro:config/client';
import Logo from '../assets/logo_combined_png.png';
import SocialLinks from '../components/SocialLinks.astro';
import backdrop from '../assets/logo3.webp';
import shareLogo from '../assets/share_logo.png';
import instagramIcon from '../assets/insta.jpg';
import facebookIcon from '../assets/facebook.svg';
import whatsappIcon from '../assets/whatsapp.png';
import { contactEmail, contactPhoneDisplay, callHref, facebookUrl, instagramUrl, websiteUrl, whatsappHref, whatsappNumber } from '../data/contact';

const bg_url = backdrop.src;
const bodyBackground = `body { background: #090d10 url('${backdrop.src}') center 42% / cover fixed no-repeat; }`; 
---

		<!doctype html>
		<html lang="en">
			<head>
				<meta charset="utf-8" />
				<meta name="viewport" content="width=device-width, initial-scale=1" />
				<meta name="description" content={description} />
				{noindex && <meta name="robots" content="noindex, nofollow" />}
				<meta name="theme-color" content="#090d10" />
				<meta name="generator" content={Astro.generator} />
				<link rel="preconnect" href="https://fonts.googleapis.com" />
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
				<!-- <style is:inline set:html={bodyBackground}></style> -->
				<title>{title}</title>
			</head>
			<body data-social-share={socialShare ? 'true' : undefined} data-base={base}>
				<script is:inline>
					/* Bikes opened from /share/ keep the sharing workspace UI on their detail page. */
					(() => {
						if (new URLSearchParams(location.search).get('social') !== '1') return;
						const shareBase = `${document.body.dataset.base || '/'}share/`;
						document.body.dataset.socialShare = 'true';
						document.querySelectorAll('.share-sheet [data-share-target]').forEach((button) => button.removeAttribute('hidden'));

						/* The detail page is prerendered with the public nav; trim it back to Buy/Rent. */
						const nav = document.querySelector('.primary-nav');
						if (nav) {
							nav.querySelectorAll(':scope > :not([data-nav])').forEach((item) => item.remove());
							const buy = nav.querySelector('[data-nav="buy"]');
							const rent = nav.querySelector('[data-nav="rent"]');
							if (buy) buy.setAttribute('href', shareBase);
							if (rent) rent.setAttribute('href', `${shareBase}rent/`);
						}
						document.querySelector('.header-contact')?.remove();
						const wordmark = document.querySelector('.wordmark');
						if (wordmark) wordmark.setAttribute('href', shareBase);
						const crumb = document.querySelector('.breadcrumbs a');
						if (crumb) crumb.setAttribute('href', shareBase);
					})();
				</script>
				<div class="site-shell">
					{!shareOnly && (
					<header class="site-header">
						<a class="wordmark" href={`${base}`} aria-label="vo2bikes home">
							<img class="wordmark-mark" aria-hidden="true" src={`${Logo.src}`}>
						</a>
						<nav class="primary-nav" aria-label="Main navigation">
							{socialShare ? (
								<>
									<a data-nav="buy" href={`${base}share/`} aria-current={shareRent ? undefined : 'page'}>BUY BIKES</a>
									<a data-nav="rent" href={`${base}share/rent/`} aria-current={shareRent ? 'page' : undefined}>RENT BIKES</a>
								</>
							) : (
								<>
									<a data-nav="buy" href={`${base}`} aria-current={currentPath === `${base}` || currentPath.startsWith(`${base}products/`) ? 'page' : undefined}>BUY BIKES</a>
									<a href={`${base}sell/`} aria-current={currentPath.startsWith(`${base}sell/`) ? 'page' : undefined}>SELL YOUR BIKE</a>
									<a href={`${base}coaching/`} aria-current={currentPath.startsWith(`${base}coaching/`) ? 'page' : undefined}>COACHING</a>
									<a href={`${base}services/`} aria-current={currentPath.startsWith(`${base}services/`) ? 'page' : undefined}>SERVICES</a>
									<a class="nav-wide" href={`${base}inspection/`} aria-current={currentPath.startsWith(`${base}inspection/`) ? 'page' : undefined}>INSPECTION</a>
									<a class="nav-wide" href={`${base}about/`} aria-current={currentPath.startsWith(`${base}about/`) ? 'page' : undefined}>ABOUT US</a>
									<details class="nav-more" aria-current={currentPath.startsWith(`${base}inspection/`) || (currentPath.startsWith(`${base}about/`)) ? 'page' : undefined}>
										<summary>More</summary>
										<div class="nav-more-list">
											<a href={`${base}inspection/`} aria-current={currentPath.startsWith(`${base}inspection/`) ? 'page' : undefined}>INSPECTION</a>
											<!-- <a href={`${base}sell/`} aria-current={currentPath.startsWith(`${base}sell/`) ? 'page' : undefined}>Sell your bike</a> -->
											<a href={`${base}about/`} aria-current={currentPath.startsWith(`${base}about/`) ? 'page' : undefined}>About Us</a>
										</div>
									</details>
								</>
							)}
						</nav>
						{!socialShare && (
							<details class="header-contact">
								<summary class="header-cta">Contact Us <span aria-hidden="true">↗</span></summary>
								<div class="header-contact-list">
									<a href={whatsappHref("Hi VO2 Bikes!")} target="_blank" rel="noopener noreferrer">
										<span class="header-contact-label">WhatsApp</span>
										<span class="header-contact-hint">Chat with us</span>
									</a>
									<a href={callHref}>
										<span class="header-contact-label">Call</span>
										<span class="header-contact-hint">{contactPhoneDisplay}</span>
									</a>
								</div>
							</details>
						)}
					</header>
					)}
					<main>
						<slot />
					</main>
					{!shareOnly && (
					<footer class="site-footer">
						<a class="footer-wordmark" href={`${base}`}>VO<sub>2</sub> Bikes <span>/ RIDE. VERIFIED</span></a>
						<p>Better bikes. Better backed.</p>
						<div class="footer-contact">
							<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
							<a class="footer-social" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="vo2bikes on Instagram" title="Instagram"><img src={instagramIcon.src} alt="" width="26" height="26" loading="lazy" /></a>
							<a class="footer-social" href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="vo2bikes on Facebook" title="Facebook"><img src={facebookIcon.src} alt="" width="26" height="26" loading="lazy" /></a>
							<a class="footer-social" href={whatsappHref("Hi VO2 Bikes! I have a question about one of your bikes.")} target="_blank" rel="noopener noreferrer" aria-label="Message vo2bikes on WhatsApp" title="WhatsApp"><img src={whatsappIcon.src} alt="" width="26" height="26" loading="lazy" /></a>
						</div>
					</footer>
					)}
				</div>
				<div class="global-share-toast" role="status" aria-live="polite" aria-atomic="true">
					<span class="share-toast-icon" aria-hidden="true">✓</span>
					<span class="share-toast-message">Link copied to clipboard</span>
				</div>
				<dialog
					class="share-sheet"
					aria-labelledby="share-sheet-title"
					data-whatsapp-number={whatsappNumber}
					data-website-url={websiteUrl}
					data-instagram-url={instagramUrl}
					data-facebook-url={facebookUrl}
					data-share-logo={shareLogo.src}
				>
					<button class="share-sheet-close" type="button" aria-label="Close sharing options">×</button>
					<p class="eyebrow">Share this bike</p>
					<h2 id="share-sheet-title">Ready to ride?</h2>
					<div class="share-preview">
						<img class="share-preview-image" src="" alt="" />
						<div class="share-preview-details">
							<strong class="share-preview-name"></strong>
							<span class="share-preview-meta"></span>
						</div>
					</div>
					{socialShare && (
						<div class="share-inline-links">
							<span>Click:</span>
							<a class="share-text-link share-text-link-primary" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Open VO2 Bikes on Instagram (@vo2bikes)">Instagram: @vo2bikes</a>
							<a class="share-text-link" href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Open VO2 Bikes on Facebook">facebook</a>
						</div>
					)}
					<label class="share-template-label" for="share-template">Your ready-to-share post</label>
					<textarea id="share-template" class="share-template" readonly rows="9"></textarea>
					{socialShare && (
						<div class="share-graphic">
							<p class="eyebrow">Ready-to-post image</p>
							<div class="share-graphic-body">
								<canvas class="share-graphic-preview" width="216" height="270" aria-label="Preview of the generated social post image"></canvas>
								<div class="share-graphic-actions">
									<button type="button" class="share-option" data-share-target="post-image">Download post image</button>
									<button type="button" class="share-option" data-share-target="status-image">Download status image</button>
									<button type="button" class="share-option" data-share-target="share-image">Share image</button>
								</div>
							</div>
						</div>
					)}
					<p class="share-hint">Pick a destination below. On phones, Instagram uses the native share sheet so you can attach the bike photos.</p>
					<div class="share-actions">
						<button type="button" class="share-option" data-share-target="whatsapp" hidden={!socialShare}>WhatsApp</button>
						<button type="button" class="share-option" data-share-target="facebook" hidden={!socialShare}>Facebook</button>
						<button type="button" class="share-option" data-share-target="instagram" hidden={!socialShare}>Instagram</button>
						<button type="button" class="share-option" data-share-target="copy" hidden={!socialShare}>Copy post</button>
						<button type="button" class="share-option" data-share-target="link">Copy link</button>
						{socialShare && (
							<button type="button" class="share-option" data-download-url="" data-download-name="">Download photo</button>
						)}
					</div>
					{socialShare && (
						<div class="share-social">
							<SocialLinks label="Find us online" compact />
						</div>
					)}
				</dialog>
				<script>
					interface ShareSpec { label: string; value: string }
					interface ShareCheck { name: string; score: number; max: number }
					interface ShareBikeData {
						url: string;
						name: string;
						year: string;
						score: string;
						price: string;
						newPrice: string;
						context: string;
						image: string;
						images: string[];
						specs: string[];
						specCards: ShareSpec[];
						checks: ShareCheck[];
						imageData: string;
					}

					const shareToast = document.querySelector<HTMLElement>('.global-share-toast');
					const shareToastMessage = shareToast?.querySelector<HTMLElement>('.share-toast-message');
					const shareSheet = document.querySelector<HTMLDialogElement>('.share-sheet');
					const shareLogoUrl = shareSheet?.dataset.shareLogo || '';
					let shareToastTimer: number | undefined;
					let currentBike: ShareBikeData | null = null;

					function showShareToast(message = 'Link copied to clipboard') {
						if (!shareToast) return;
						if (shareToastMessage) shareToastMessage.textContent = message;
						shareToast.classList.add('is-visible');
						window.clearTimeout(shareToastTimer);
						shareToastTimer = window.setTimeout(() => shareToast.classList.remove('is-visible'), 2400);
					}

					async function copyText(text: string): Promise<boolean> {
						try {
							await navigator.clipboard.writeText(text);
							return true;
						} catch {
							// Older browsers and some mobile contexts block the async clipboard.
						}
						try {
							const input = document.createElement('textarea');
							input.value = text;
							input.setAttribute('readonly', '');
							input.style.position = 'fixed';
							input.style.opacity = '0';
							document.body.appendChild(input);
							input.select();
							const copied = document.execCommand('copy');
							input.remove();
							return copied;
						} catch {
							return false;
						}
					}

					function safeFilename(name: string): string {
						return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'bike';
					}

					function downloadImage(btn: HTMLElement) {
						const src = btn.dataset.downloadUrl;
						if (!src) return;
						const name = btn.dataset.downloadName || currentBike?.name || 'bike';
						try {
							/* Sanity's `dl` parameter sets Content-Disposition: attachment.
							   Navigating there downloads without a CORS-restricted fetch. */
							const url = new URL(src, window.location.origin);
							const extension = url.pathname.split('.').pop()?.toLowerCase() || 'jpg';
							url.searchParams.set('dl', `${safeFilename(name)}.${extension}`);
							window.location.href = url.href;
							showShareToast('Photo downloaded');
						} catch {
							window.open(src, '_blank', 'noopener,noreferrer');
							showShareToast('Photo opened — save it from the new tab');
						}
					}

					function buildPost(data: ShareBikeData, platform: 'whatsapp' | 'plain' = 'plain'): string {
						const isWhatsApp = platform === 'whatsapp';
						/* WhatsApp has native ~strike~ and *bold*. Other apps have no native
						   strikethrough, so use Unicode combining overlay marks as a fallback. */
						const strong = (text: string) => (isWhatsApp ? `*${text}*` : text);
						const strikeMarks = String.fromCharCode(0x0336, 0x0335);
						const strike = (text: string) =>
							isWhatsApp ? `~${text}~` : text.split('').map((char) => (char === ' ' ? char : `${char}${strikeMarks}`)).join('');

						const bikeName = `${data.year ? `${data.year} ` : ''}${data.name}`.trim();
						const heading = data.context === 'rent' ? 'FOR RENT' : 'FOR SALE';
						const number = shareSheet?.dataset.whatsappNumber || '';
						const phone = number ? `+91 ${number.slice(2)}` : '+91 9370343713';
						const websiteLink = shareSheet?.dataset.websiteUrl || 'https://www.vo2bikes.com/';
						const instagramLink = shareSheet?.dataset.instagramUrl || 'https://www.instagram.com/vo2bikes/';
						const facebookLink = shareSheet?.dataset.facebookUrl || 'https://www.facebook.com/share/19RrCYiHSx/?mibextid=wwXIfr';

						const lines = [
							strong('VO₂ BIKES'),
							'',
							strong(`${heading}: ${bikeName}`),
							'',
						];

						const priceParts = [data.newPrice && strike(data.newPrice), data.price && strong(data.price)].filter(Boolean);
						if (priceParts.length) lines.push(priceParts.join(' '), '');

						lines.push('Location: Pune, India · Delivery across India', '');

						lines.push(strong('Bike Specifications'));
						data.specs.forEach((spec) => {
							const divider = spec.indexOf(':');
							const label = (divider === -1 ? spec : spec.slice(0, divider)).trim();
							const value = divider === -1 ? '' : spec.slice(divider + 1).trim();
							lines.push(`- ${label}${value ? `: ${value}` : ''}`);
						});

						lines.push(
							'',
							'More Photos & Complete Specifications:',
							data.url,
							'',
							'Interested? Feel free to connect with us for more details.',
							'',
							`Call / WhatsApp: ${phone}`,
							`Insta: ${instagramLink}`,
							`FB: ${facebookLink}`,
							websiteLink,
							'',
							strong('VO₂ BIKES – RIDE. VERIFIED.'),
						);
						return lines.join('\n');
					}

					function parseShareJson<T>(raw: string | undefined, fallback: T): T {
						try {
							return raw ? (JSON.parse(raw) as T) : fallback;
						} catch {
							return fallback;
						}
					}

					function readShareData(btn: HTMLElement): ShareBikeData {
						return {
							url: new URL(btn.dataset.shareUrl || '', window.location.origin).href,
							name: btn.dataset.shareName || 'This bike',
							year: btn.dataset.shareYear || '',
							score: btn.dataset.shareScore || '',
							price: btn.dataset.sharePrice || '',
							newPrice: btn.dataset.shareNewPrice || '',
							context: btn.dataset.shareContext || 'buy',
							image: btn.dataset.shareImage || '',
							images: (btn.dataset.shareImages || '').split(',').filter(Boolean),
							specs: (btn.dataset.shareSpecs || '').split(' | ').filter(Boolean),
							specCards: parseShareJson<ShareSpec[]>(btn.dataset.shareSpecJson, []),
							checks: parseShareJson<ShareCheck[]>(btn.dataset.shareChecks, []),
							imageData: btn.dataset.shareImageData || '',
						};
					}

					function wrapCanvasText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number, maxLines: number) {
						const words = text.split(/\s+/).filter(Boolean);
						const lines: string[] = [];
						let line = '';
						for (const word of words) {
							const next = line ? `${line} ${word}` : word;
							if (ctx.measureText(next).width > maxWidth && line) {
								lines.push(line);
								line = word;
							} else {
								line = next;
							}
						}
						if (line) lines.push(line);
						if (lines.length <= maxLines) return lines;
						const kept = lines.slice(0, maxLines);
						kept[maxLines - 1] = `${kept[maxLines - 1].replace(/\s+\S*$/, '')}…`;
						return kept;
					}

					function fitCanvasText(
						ctx: CanvasRenderingContext2D,
						text: string,
						x: number,
						y: number,
						maxWidth: number,
						baseSize: number,
						minSize: number,
						weight: number,
						family: string,
						color: string,
					) {
						let size = baseSize;
						ctx.font = `${weight} ${size}px '${family}', sans-serif`;
						while (ctx.measureText(text).width > maxWidth && size > minSize) {
							size -= 1;
							ctx.font = `${weight} ${size}px '${family}', sans-serif`;
						}
						ctx.fillStyle = color;
						ctx.fillText(text, x, y);
					}

					function roundedRect(
						ctx: CanvasRenderingContext2D,
						x: number,
						y: number,
						width: number,
						height: number,
						radius: number,
					) {
						const r = Math.min(radius, height / 2, width / 2);
						ctx.beginPath();
						ctx.moveTo(x + r, y);
						ctx.arcTo(x + width, y, x + width, y + height, r);
						ctx.arcTo(x + width, y + height, x, y + height, r);
						ctx.arcTo(x, y + height, x, y, r);
						ctx.arcTo(x, y, x + width, y, r);
						ctx.closePath();
					}

					async function loadGraphicImage(dataUrl: string): Promise<HTMLImageElement | null> {
						if (!dataUrl) return null;
						const image = new Image();
						image.src = dataUrl;
						try {
							await image.decode();
						} catch {
							// Fall back to the branded placeholder below.
						}
						return image.naturalWidth ? image : null;
					}

					async function renderShareCanvas(data: ShareBikeData, format: 'post' | 'status'): Promise<HTMLCanvasElement> {
						await document.fonts.ready;
						const canvas = document.createElement('canvas');
						const cardWidth = 1080;
						const cardHeight = 1350;
						const height = format === 'status' ? 1920 : 1350;
						const offsetY = (height - cardHeight) / 2;
						canvas.width = cardWidth;
						canvas.height = height;
						const ctx = canvas.getContext('2d');
						if (!ctx) return canvas;

						ctx.fillStyle = '#090d10';
						ctx.fillRect(0, 0, cardWidth, height);
						ctx.strokeStyle = 'rgba(226, 242, 244, 0.045)';
						ctx.lineWidth = 1;
						for (let x = 0; x <= cardWidth; x += 90) {
							ctx.beginPath(); ctx.moveTo(x + 0.5, 0); ctx.lineTo(x + 0.5, height); ctx.stroke();
						}
						for (let y = 0; y <= height; y += 90) {
							ctx.beginPath(); ctx.moveTo(0, y + 0.5); ctx.lineTo(cardWidth, y + 0.5); ctx.stroke();
						}

						ctx.save();
						ctx.translate(0, offsetY);

						const logo = await loadGraphicImage(shareLogoUrl);
						if (logo) {
							const logoWidth = 230;
							const logoHeight = logoWidth * (logo.naturalHeight / logo.naturalWidth);
							ctx.drawImage(logo, 56, 14, logoWidth, logoHeight);
						}
						ctx.fillStyle = '#00ff11';
						ctx.fillRect(56, 130, 84, 4);

						const heading = data.context === 'rent' ? 'FOR RENT · PRE-OWNED' : 'FOR SALE · PRE-OWNED';
						ctx.fillStyle = '#00ff11';
						ctx.font = "700 22px 'DM Sans', sans-serif";
						ctx.fillText(heading, 56, 164);

						const title = `${data.year ? `${data.year} ` : ''}${data.name}`.toUpperCase();
						let titleSize = 78;
						let titleLines = wrapCanvasText(ctx, title, 968, 2);
						while (titleLines.length > 2 && titleSize > 48) {
							titleSize -= 4;
							ctx.font = `700 ${titleSize}px 'Barlow Condensed', sans-serif`;
							titleLines = wrapCanvasText(ctx, title, 968, 2);
						}
						ctx.fillStyle = '#f1f7f8';
						ctx.font = `700 ${titleSize}px 'Barlow Condensed', sans-serif`;
						titleLines.forEach((line, index) => ctx.fillText(line, 56, 232 + index * 70));

						const imageY = 232 + (titleLines.length - 1) * 70 + 24;
						const shift = imageY - 318;
						const image = await loadGraphicImage(data.imageData);
						ctx.fillStyle = '#f1f7f8';
						ctx.fillRect(56, imageY, 968, 400);
						if (image) {
							const scale = Math.min(968 / image.naturalWidth, 400 / image.naturalHeight);
							const width = image.naturalWidth * scale;
							const height = image.naturalHeight * scale;
							ctx.drawImage(image, 56 + (968 - width) / 2, imageY + (400 - height) / 2, width, height);
						} else {
							ctx.fillStyle = '#151d20';
							ctx.font = "700 42px 'Barlow Condensed', sans-serif";
							ctx.textAlign = 'center';
							ctx.fillText(data.name.toUpperCase(), 540, 530 + shift);
							ctx.textAlign = 'left';
						}
						ctx.strokeStyle = 'rgba(0, 255, 17, 0.5)';
						ctx.lineWidth = 2;
						ctx.strokeRect(56, imageY, 968, 400);
						ctx.fillStyle = 'rgba(7, 13, 15, 0.92)';
						ctx.fillRect(72, 332 + shift, 196, 34);
						ctx.fillStyle = '#00ff11';
						ctx.font = "700 18px 'DM Sans', sans-serif";
						ctx.fillText('✓ INSPECTED', 86, 355 + shift);

						if (data.context === 'rent') {
							ctx.fillStyle = '#f1f7f8';
							ctx.font = "700 64px 'Barlow Condensed', sans-serif";
							ctx.fillText('PRICE ON REQUEST', 56, 835 + shift);
						} else {
							if (data.newPrice) {
								ctx.font = "500 34px 'DM Sans', sans-serif";
								ctx.fillStyle = '#aab8bc';
								const oldWidth = ctx.measureText(data.newPrice).width;
								ctx.fillText(data.newPrice, 56, 766 + shift);
								ctx.strokeStyle = '#aab8bc';
								ctx.lineWidth = 2;
								ctx.beginPath(); ctx.moveTo(56, 755 + shift); ctx.lineTo(56 + oldWidth, 755 + shift); ctx.stroke();
							}
							ctx.fillStyle = '#f1f7f8';
							ctx.font = "700 72px 'Barlow Condensed', sans-serif";
							ctx.fillText(data.price || 'PRICE ON REQUEST', 56, 835 + shift);
						}

						ctx.fillStyle = '#00ff11';
						ctx.font = "700 19px 'DM Sans', sans-serif";
						ctx.fillText('📍 AVAILABLE IN PUNE · Delivery across India', 56, 880 + shift);

						ctx.fillStyle = '#aab8bc';
						ctx.font = "700 18px 'DM Sans', sans-serif";
						ctx.fillText(data.context === 'rent' ? 'RENTAL DETAILS' : 'KEY SPECS', 56, 928 + shift);
						data.specCards.slice(0, 4).forEach((spec, index) => {
							const x = 56 + (index % 2) * 496;
							const y = 968 + Math.floor(index / 2) * 64 + shift;
							ctx.fillStyle = '#00ff11';
							ctx.font = "700 16px 'DM Sans', sans-serif";
							ctx.fillText(spec.label.toUpperCase(), x, y);
							let valueSize = 24;
							ctx.font = `600 ${valueSize}px 'DM Sans', sans-serif`;
							while (ctx.measureText(spec.value).width > 462 && valueSize > 17) {
								valueSize -= 1;
								ctx.font = `600 ${valueSize}px 'DM Sans', sans-serif`;
							}
							ctx.fillStyle = '#f1f7f8';
							ctx.fillText(spec.value, x, y + 27);
						});

						ctx.fillStyle = '#aab8bc';
						ctx.font = "700 18px 'DM Sans', sans-serif";
						ctx.fillText('INSPECTION SCORE', 56, 1104 + shift);

						const checks = data.checks.slice(0, 6);
						const totalMax = checks.reduce((sum, check) => sum + Math.max(check.max, 0), 0);
						const checkTotal = checks.reduce((sum, check) => sum + Math.max(check.score, 0), 0);
						const parsedScore = Number(data.score);
						const scoreValue = data.score && Number.isFinite(parsedScore)
							? parsedScore
							: checks.length && totalMax > 0
								? (checkTotal / totalMax) * 100
								: 0;
						const scoreText = data.score || (checks.length ? String(Math.round(scoreValue)) : '—');
						const scoreRatio = Math.max(0, Math.min(1, scoreValue / 100));

						ctx.textAlign = 'right';
						ctx.fillStyle = '#00ff11';
						ctx.font = "700 22px 'DM Sans', sans-serif";
						ctx.fillText(`${scoreText}/100`, 1024, 1104 + shift);
						ctx.textAlign = 'left';

						const trackX = 56;
						const trackWidth = 968;
						const trackY = 1130 + shift;
						const trackHeight = 18;
						const progressWidth = trackWidth * scoreRatio;

						roundedRect(ctx, trackX, trackY, trackWidth, trackHeight, trackHeight / 2);
						ctx.fillStyle = 'rgba(226, 242, 244, 0.12)';
						ctx.fill();
						ctx.strokeStyle = 'rgba(226, 242, 244, 0.16)';
						ctx.lineWidth = 1;
						ctx.stroke();

						if (progressWidth > 2) {
							ctx.save();
							const gradient = ctx.createLinearGradient(trackX, 0, trackX + progressWidth, 0);
							gradient.addColorStop(0, '#008f0d');
							gradient.addColorStop(0.55, '#00ff11');
							gradient.addColorStop(1, '#c8ffc0');
							ctx.shadowColor = 'rgba(0, 255, 17, 0.55)';
							ctx.shadowBlur = 16;
							roundedRect(ctx, trackX, trackY, progressWidth, trackHeight, trackHeight / 2);
							ctx.fillStyle = gradient;
							ctx.fill();
							ctx.restore();

							ctx.save();
							ctx.globalAlpha = 0.55;
							roundedRect(ctx, trackX + 6, trackY + 3, Math.max(0, progressWidth - 12), 4, 2);
							ctx.fillStyle = '#f0fff0';
							ctx.fill();
							ctx.restore();
						}

						const numberRaw = shareSheet?.dataset.whatsappNumber || '';
						const phoneDisplay = numberRaw ? `+91 ${numberRaw.slice(2)}` : '+91 9370343713';
						const website = shareSheet?.dataset.websiteUrl || 'https://www.vo2bikes.com/';
						const footerBase = 1240 + shift;
						fitCanvasText(ctx, 'CALL / WHATSAPP', 56, footerBase, 460, 18, 14, 700, 'DM Sans', '#00ff11');
						fitCanvasText(ctx, phoneDisplay, 56, footerBase + 40, 460, 36, 24, 700, 'Barlow Condensed', '#f1f7f8');
						fitCanvasText(ctx, `Website: ${website}`, 56, footerBase + 76, 460, 21, 15, 600, 'DM Sans', '#aab8bc');
						fitCanvasText(ctx, 'FOLLOW', 540, footerBase, 484, 18, 14, 700, 'DM Sans', '#00ff11');
						fitCanvasText(ctx, 'Instagram: @vo2bikes', 540, footerBase + 40, 484, 25, 18, 600, 'DM Sans', '#f1f7f8');

						ctx.restore();
						return canvas;
					}

					function canvasToBlob(canvas: HTMLCanvasElement): Promise<Blob> {
						return new Promise((resolve, reject) => {
							canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('Image export failed'))), 'image/png');
						});
					}

					function downloadBlob(blob: Blob, filename: string) {
						const url = URL.createObjectURL(blob);
						const link = document.createElement('a');
						link.href = url;
						link.download = filename;
						document.body.append(link);
						link.click();
						link.remove();
						window.setTimeout(() => URL.revokeObjectURL(url), 1000);
					}

					async function exportShareImage(format: 'post' | 'status', share: boolean) {
						if (!currentBike) return;
						const canvas = await renderShareCanvas(currentBike, format);
						const blob = await canvasToBlob(canvas);
						const filename = `${safeFilename(currentBike.name)}-${format}.png`;
						if (share && typeof navigator.share === 'function') {
							const file = new File([blob], filename, { type: 'image/png' });
							const canShare = (navigator as Navigator & { canShare?: (data: { files: File[] }) => boolean }).canShare?.({ files: [file] });
							if (canShare) {
								try {
									await navigator.share({ files: [file], title: currentBike.name, text: `VO₂ BIKES — ${currentBike.name}` });
									showShareToast('Post image shared');
									return;
								} catch (error) {
									if ((error as DOMException)?.name === 'AbortError') return;
								}
							}
						}
						downloadBlob(blob, filename);
						showShareToast(format === 'status' ? 'Status image downloaded' : 'Post image downloaded');
					}

					async function openShareSheet(btn: HTMLElement) {
						if (!shareSheet) return;
						currentBike = readShareData(btn);

						/* Public pages only copy the link. Social sharing lives on the unlisted /share/ page. */
						if (document.body.dataset.socialShare !== 'true') {
							void copyText(currentBike.url).then((copied) =>
								showShareToast(copied ? 'Link copied to clipboard' : 'Select the link to copy it'),
							);
							return;
						}

						const post = buildPost(currentBike, 'plain');
						const title = shareSheet.querySelector<HTMLElement>('#share-sheet-title');
						const previewImage = shareSheet.querySelector<HTMLImageElement>('.share-preview-image');
						const previewName = shareSheet.querySelector<HTMLElement>('.share-preview-name');
						const previewMeta = shareSheet.querySelector<HTMLElement>('.share-preview-meta');
						const template = shareSheet.querySelector<HTMLTextAreaElement>('#share-template');

						if (title) title.textContent = currentBike.name;
						if (previewImage) {
							previewImage.src = currentBike.image;
							previewImage.alt = currentBike.name;
						}
						if (previewName) {
							previewName.textContent = `${currentBike.year ? `${currentBike.year} ` : ''}${currentBike.name}`.trim();
						}
						if (previewMeta) {
							previewMeta.textContent =
								currentBike.context === 'rent'
									? 'Available for rent'
									: [currentBike.score && `${currentBike.score}/100`, currentBike.price].filter(Boolean).join(' · ');
						}
						if (template) template.value = post;
						const graphicPreview = shareSheet.querySelector<HTMLCanvasElement>('.share-graphic-preview');
						if (graphicPreview) {
							const previewCtx = graphicPreview.getContext('2d');
							if (previewCtx) {
								const generated = await renderShareCanvas(currentBike, 'post');
								previewCtx.clearRect(0, 0, graphicPreview.width, graphicPreview.height);
								previewCtx.drawImage(generated, 0, 0, graphicPreview.width, graphicPreview.height);
							}
						}
						const download = shareSheet.querySelector<HTMLElement>('[data-download-url]');
						if (download) {
							download.dataset.downloadUrl = currentBike.image;
							download.dataset.downloadName = currentBike.name;
						}
						if (!shareSheet.open) shareSheet.showModal();
					}

					async function shareToInstagram(post: string) {
						const copied = await copyText(post);
						window.open('https://www.instagram.com/', '_blank', 'noopener,noreferrer');
						showShareToast(copied ? 'Post copied — paste it into Instagram' : 'Select the post text to copy it');
					}

					async function handleShareTarget(target?: string) {
						if (!currentBike) return;
						const post = buildPost(currentBike, target === 'whatsapp' ? 'whatsapp' : 'plain');
						const number = shareSheet?.dataset.whatsappNumber || '';
						if (target === 'whatsapp') {
							window.open(`https://wa.me/${number}?text=${encodeURIComponent(post)}`, '_blank', 'noopener,noreferrer');
							void copyText(post).then((copied) =>
								showShareToast(copied ? 'Post copied — add photos in WhatsApp' : 'Your post is ready in the share sheet'),
							);
							return;
						}
						if (target === 'facebook') {
							const sharer = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentBike.url)}&quote=${encodeURIComponent(post)}`;
							window.open(sharer, '_blank', 'noopener,noreferrer');
							void copyText(post).then((copied) =>
								showShareToast(copied ? 'Post copied — add photos on Facebook' : 'Your post is ready in the share sheet'),
							);
							return;
						}
						if (target === 'instagram') {
							await shareToInstagram(post);
							return;
						}
						if (target === 'copy') {
							const copied = await copyText(post);
							showShareToast(copied ? 'Post copied — paste it anywhere' : 'Select the post text to copy it');
							return;
						}
						if (target === 'post-image' || target === 'status-image') {
							await exportShareImage(target === 'status-image' ? 'status' : 'post', false);
							return;
						}
						if (target === 'share-image') {
							await exportShareImage('post', true);
							return;
						}
						if (target === 'link') {
							const copied = await copyText(currentBike.url);
							showShareToast(copied ? 'Link copied to clipboard' : 'Select the link to copy it');
						}
					}

					/* One delegated handler covers bike cards, detail pages, and ?mode=rent. */
					document.addEventListener('click', (event) => {
						const target = event.target instanceof Element ? event.target : null;
						const btn = target?.closest<HTMLElement>('[data-share-url]');
						if (btn) {
							void openShareSheet(btn);
							return;
						}
						const option = target?.closest<HTMLElement>('[data-share-target]');
						if (option) {
							void handleShareTarget(option.dataset.shareTarget);
							return;
						}
						const download = target?.closest<HTMLElement>('[data-download-url]');
						if (download) void downloadImage(download);
					});

					shareSheet?.querySelector('.share-sheet-close')?.addEventListener('click', () => shareSheet.close());
					shareSheet?.addEventListener('click', (event) => {
						if (event.target === shareSheet) shareSheet.close();
					});
				</script>
				<style is:global>

---
import Layout from '../layouts/Layout.astro';
import ProductInventory from './ProductInventory.astro';
import { getBicycles } from '../data/bicycles';
import { base } from 'astro:config/client';

interface Props {
	rentMode?: boolean;
}

const { rentMode = false } = Astro.props;
const bicycles = await getBicycles();
const visibleBikes = rentMode ? bicycles.filter((bike) => bike.isRentable) : bicycles;
---

<!--
	Intentionally unlisted: these workspace pages are not linked from the public
	nav, footer or any other public page, and they are noindexed. Only people
	given the URL can open the social-sharing tools.
-->
<Layout
	title={rentMode ? 'Rent bikes — sharing workspace | VO2 Bikes' : 'Buy bikes — sharing workspace | VO2 Bikes'}
	description="Internal inventory sharing workspace for VO2 Bikes."
	socialShare
	noindex
	shareOnly
>
	<section class="share-intro">
		<p class="eyebrow">Inventory / sharing workspace</p>
		<h1 class="display-heading">Share the <span>ride.</span></h1>
		<p class="lead">Pick a bike below, then use its share or download buttons for a ready-to-post caption and photo.</p>
	</section>

	<section class="share-inventory" aria-label={rentMode ? 'Rental bicycles available to share' : 'Bicycles for sale available to share'}>
		<nav class="share-tabs" aria-label="Inventory type">
			<a href={`${base}share/`} aria-current={rentMode ? undefined : 'page'}>Buy a Bike</a>
			<a href={`${base}share/rent/`} aria-current={rentMode ? 'page' : undefined}>Rent a Bike</a>
		</nav>
		<ProductInventory bicycles={visibleBikes} mode={rentMode ? 'rent' : 'buy'} shareDetail />
	</section>
</Layout>

<style>
	.share-intro {
		max-width: 1440px;
		margin: 0 auto;
		padding: 3rem clamp(1.25rem, 10vw, 10rem) 2rem;
		border-top: 1px solid var(--line);
		background: rgba(8, 12, 15, 0.96);
	}
	.share-intro .lead { max-width: 620px; margin: 1rem 0 0; }
	.share-inventory { padding: 1rem clamp(1.25rem, 7vw, 7rem) 4rem; }
	.share-tabs {
		display: flex;
		gap: 0.5rem;
		max-width: 1440px;
		margin: 0 auto 1.5rem;
		border-bottom: 1px solid var(--line);
	}
	.share-tabs a {
		padding: 0.8rem 1.2rem;
		border: 1px solid transparent;
		border-bottom: 0;
		color: var(--muted);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.share-tabs a:hover { color: var(--paper); }
	.share-tabs a[aria-current='page'] {
		border-color: var(--line);
		background: rgba(9, 14, 17, 0.94);
		color: var(--signal);
	}
	@media (max-width: 760px) {
		.share-intro { padding: 2.5rem 1.4rem; }
		.share-inventory { padding: 1rem 1rem 3rem; }
		.share-tabs a { flex: 1; padding: 0.75rem 0.5rem; text-align: center; }
	}
</style>

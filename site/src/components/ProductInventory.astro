---
import { bicycles, imageUrl } from '../data/bicycles';
---

<div class="inventory-tools" aria-label="Filter bicycle inventory">
	<label class="search-field">
		<span class="visually-hidden">Search pre-owned bikes</span>
		<span class="search-icon" aria-hidden="true">⌕</span>
		<input type="search" id="bike-search" placeholder="Search model or type" autocomplete="off" />
	</label>
	<label class="select-field">
		<span class="visually-hidden">Filter by bike type</span>
		<select id="bike-category">
			<option value="all">All bike types</option>
			<option value="road">Road</option>
			<option value="climbing">Climbing</option>
			<option value="time trial">Time trial</option>
			<option value="endurance">Endurance</option>
			<option value="gravel">Gravel</option>
		</select>
	</label>
	<label class="select-field">
		<span class="visually-hidden">Filter by inspection score</span>
		<select id="bike-score">
			<option value="0">All scores</option>
			<option value="90">90 and above</option>
			<option value="95">95 and above</option>
		</select>
	</label>
	<p class="result-count" aria-live="polite"><span id="bike-count">6</span> verified bikes</p>
</div>

<div class="bike-grid" id="bike-grid">
	{bicycles.map((bike) => (
		<article class="bike-card" data-name={`${bike.name} ${bike.category}`.toLowerCase()} data-category={bike.category} data-score={bike.score}>
			<a class="bike-photo" href={`/products/${bike.slug}/`} aria-label={`View details for ${bike.name}`}>
				<img src={imageUrl(bike.image)} alt={bike.alt} loading="lazy" />
				<span class="bike-year">{bike.year}</span>
				<span class="verified-tag"><span aria-hidden="true">✓</span> INSPECTED</span>
			</a>
			<div class="bike-details">
				<div class="bike-title-row">
					<div><p class="bike-category">PRE-OWNED <span>·</span> {bike.category}</p><h3><a class="bike-title-link" href={`/products/${bike.slug}/`}>{bike.name}</a></h3></div>
					<div class="inspection-score" aria-label={`Inspection score ${bike.score} out of 100`}><strong>{bike.score}</strong><span>/100</span></div>
				</div>
				<div class="score-track" aria-hidden="true"><span style={`width: ${bike.score}%`}></span></div>
				<div class="bike-meta"><span>{bike.distance} ridden</span><strong>{bike.price}</strong></div>
				<a class="details-link" href={`/products/${bike.slug}/`}>View bike details <span aria-hidden="true">↗</span></a>
				<details class="inspection-report">
					<summary>Inspection breakdown</summary>
					<ul>{bike.checks.map((check) => <li><span>{check.name}</span><strong>{check.score}<small>/{check.max}</small></strong></li>)}</ul>
				</details>
				<a class="enquire-link" href={`mailto:hello@vo2bikes.example?subject=${encodeURIComponent(`Enquiry: ${bike.name}`)}`}>Ask about this bike <span aria-hidden="true">↗</span></a>
			</div>
		</article>
	))}
</div>
<p class="empty-state" id="empty-state" hidden>No bikes match those filters. Try adjusting your search.</p>

<script>
	const search = document.querySelector<HTMLInputElement>('#bike-search');
	const category = document.querySelector<HTMLSelectElement>('#bike-category');
	const minimumScore = document.querySelector<HTMLSelectElement>('#bike-score');
	const cards = [...document.querySelectorAll<HTMLElement>('.bike-card')];
	const count = document.querySelector<HTMLElement>('#bike-count');
	const emptyState = document.querySelector<HTMLElement>('#empty-state');

	function updateInventory() {
		const query = search?.value.trim().toLowerCase() ?? '';
		const selectedCategory = category?.value ?? 'all';
		const scoreThreshold = Number(minimumScore?.value ?? 0);
		let visibleCount = 0;

		cards.forEach((card) => {
			const matchesQuery = card.dataset.name?.includes(query) ?? false;
			const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
			const matchesScore = Number(card.dataset.score ?? 0) >= scoreThreshold;
			card.hidden = !(matchesQuery && matchesCategory && matchesScore);
			if (!card.hidden) visibleCount += 1;
		});

		if (count) count.textContent = String(visibleCount);
		if (emptyState) emptyState.hidden = visibleCount > 0;
	}

	search?.addEventListener('input', updateInventory);
	category?.addEventListener('change', updateInventory);
	minimumScore?.addEventListener('change', updateInventory);
</script>

<style>
	.inventory-tools { display: flex; align-items: center; gap: 0.65rem; margin: 0 auto 1.5rem; max-width: 1440px; padding: 0.7rem; border: 1px solid var(--line); background: rgba(9, 14, 17, 0.94); }
	.search-field, .select-field { display: flex; align-items: center; min-height: 42px; border: 1px solid var(--line); background: rgba(6, 10, 12, 0.72); }
	.search-field { flex: 1; min-width: 180px; }
	.search-icon { padding-left: 0.8rem; color: var(--signal); font-size: 1.35rem; line-height: 1; }
	input, select { width: 100%; min-height: 40px; border: 0; outline: 0; background: transparent; color: var(--paper); font-size: 0.75rem; }
	input { padding: 0 0.7rem; }
	input::placeholder { color: #aab8bc; }
	select { min-width: 150px; padding: 0 2rem 0 0.8rem; cursor: pointer; }
	select option { background: #10171a; color: var(--paper); }
	.result-count { min-width: 116px; margin: 0; padding: 0 0.5rem; color: var(--muted); font-size: 0.68rem; text-align: right; }
	.result-count span { color: var(--paper); font-weight: 700; }
	.bike-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; max-width: 1440px; margin: 0 auto; }
	.bike-card { min-width: 0; border: 1px solid rgba(226, 242, 244, 0.16); background: var(--panel); animation: card-arrive 420ms ease both; }
	.bike-card[hidden] { display: none; }
	.bike-photo { position: relative; display: block; height: 220px; overflow: hidden; background: #151d20; }
	.bike-photo::after { position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgba(5, 9, 12, 0.58)); content: ''; pointer-events: none; }
	.bike-photo img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.76); transition: transform 350ms ease, filter 350ms ease; }
	.bike-card:hover .bike-photo img { filter: saturate(1); transform: scale(1.04); }
	.bike-year { position: absolute; z-index: 1; bottom: 0.8rem; left: 0.9rem; color: white; font-family: 'Barlow Condensed', sans-serif; font-size: 1.3rem; font-weight: 700; }
	.verified-tag { position: absolute; z-index: 1; top: 0.8rem; left: 0.8rem; display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.55rem; border: 1px solid rgba(131, 229, 220, 0.65); background: rgba(7, 13, 15, 0.86); color: var(--signal); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; }
	.verified-tag span { font-size: 0.75rem; }
	.bike-details { padding: 1rem 1rem 0.85rem; }
	.bike-title-row { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
	.bike-category { margin: 0 0 0.35rem; color: var(--signal); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
	.bike-category span { color: var(--muted); }
	.bike-title-row h3 { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
	.bike-title-link { color: inherit; text-decoration: none; }
	.bike-title-link:hover { color: var(--signal); }
	.inspection-score { display: flex; align-items: baseline; gap: 0.16rem; white-space: nowrap; }
	.inspection-score strong { color: var(--signal); font-family: 'Barlow Condensed', sans-serif; font-size: 1.8rem; line-height: 1; }
	.inspection-score span { color: var(--muted); font-size: 0.56rem; }
	.score-track { height: 3px; margin-top: 0.8rem; background: rgba(226, 242, 244, 0.14); }
	.score-track span { display: block; height: 100%; background: var(--signal); }
	.bike-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.8rem; padding-top: 0.75rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.65rem; }
	.bike-meta strong { color: var(--paper); font-size: 0.8rem; white-space: nowrap; }
	.details-link { display: flex; align-items: center; justify-content: space-between; margin-top: 0.7rem; padding-top: 0.7rem; border-top: 1px solid var(--line); color: var(--paper); font-size: 0.68rem; font-weight: 700; text-decoration: none; }
	.details-link span { color: var(--signal); }
	.inspection-report { margin-top: 0.75rem; border-top: 1px solid var(--line); }
	.inspection-report summary { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.75rem 0 0.15rem; color: var(--paper); cursor: pointer; font-size: 0.66rem; font-weight: 700; list-style: none; }
	.inspection-report summary::-webkit-details-marker { display: none; }
	.inspection-report summary::after { color: var(--signal); content: '+'; font-size: 1rem; line-height: 0.8; }
	.inspection-report[open] summary::after { content: '−'; }
	.inspection-report ul { display: grid; gap: 0.38rem; margin: 0.75rem 0; padding: 0; list-style: none; }
	.inspection-report li { display: flex; justify-content: space-between; gap: 0.6rem; color: var(--muted); font-size: 0.62rem; }
	.inspection-report li strong { color: var(--paper); font-size: 0.64rem; }
	.inspection-report li small { color: var(--muted); font-size: 0.58rem; }
	.enquire-link { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.6rem; padding-top: 0.7rem; border-top: 1px solid var(--line); color: var(--paper); font-size: 0.68rem; font-weight: 700; text-decoration-color: var(--signal); text-underline-offset: 4px; }
	.enquire-link span { color: var(--signal); }
	.empty-state { max-width: 1440px; margin: 2rem auto; padding: 2rem; border: 1px dashed var(--line); color: var(--muted); text-align: center; }
	.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	@keyframes card-arrive { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
	@media (max-width: 960px) { .bike-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 640px) {
		.inventory-tools { flex-wrap: wrap; }
		.search-field { flex-basis: 100%; }
		.select-field { flex: 1; min-width: 0; }
		select { min-width: 0; font-size: 0.68rem; }
		.result-count { flex: 1; text-align: left; }
		.bike-grid { grid-template-columns: 1fr; }
		.bike-photo { height: 240px; }
	}
</style>